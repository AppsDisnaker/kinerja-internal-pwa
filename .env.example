# Kinerja Internal API Configuration
# Copy this file to .env and fill in the values

# Server Port
PORT=3000

# Google Spreadsheet ID
# Find this in your Google Sheets URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet Names (case sensitive, must match your Google Sheets)
SHEET_USERS=Users
SHEET_DATA_KINERJA=Data Kinerja
SHEET_REFERENSI=Data Referensi

# Google Cloud Service Account Credentials
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a project or select existing project
# 3. Enable Google Sheets API
# 4. Create a Service Account
# 5. Download the JSON key file
# 6. Copy the values below from the JSON file

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# Share your Google Sheet with the service account email address
